{
  "board": "project-board",
  "repo": "owner/repository",
  "api": "https://forgejo.example.invalid/api/v1",
  "credential_host": "forgejo.example.invalid",
  "repo_dir": "~/src/repository",
  "base_branch": "dev",
  "state_path": "~/.hermes/state/minna-review-cycle.json",
  "review_profile": "reviewer",
  "review_provider": "custom:review-provider",
  "review_model": "provider/reviewer-model",
  "review_vendor_family": "reviewer-vendor",
  "implementation_profile": "implementer",
  "implementation_vendor_family": "implementer-vendor",
  "leaf_runtime": "25m",
  "fan_in_runtime": "10m",
  "leaf_evidence_budget_seconds": 900,
  "leaf_command_timeout_seconds": 120,
  "review_preflight_timeout_seconds": 300,
  "rework_runtime": "45m",
  "gate_timeout_seconds": 1800,
  "gate_commands": [
    ["unit", "python3 -m pytest -q"],
    ["lint", "python3 -m compileall -q src"]
  ],
  "max_gates_per_tick": 1,
  "max_leaves_in_flight": 2,
  "max_merges_per_tick": 1,
  "max_files_per_leaf": 5,
  "max_review_rounds": 3,
  "merge_method": "merge",
  "priority_prs": [],
  "force_fresh_review_prs": [],
  "merge_order": []
}
